<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="vvmplayer">
  <schema id="org.kop316.vvmplayer" path="/org/kop316/vvmplayer/">

    <key name="version" type="s">
      <default>""</default>
      <summary>Version of the application</summary>
      <description>Version of the application</description>
    </key>

    <key name="spam-contact" type="s">
      <default>"Spam"</default>
      <summary>Spam Contact</summary>
      <description>The contact to consider as spam</description>
    </key>

    <key name="spam-contact-enabled" type="b">
      <default>false</default>
      <summary>Delete Spam Contact VVM</summary>
      <description>Autodelete Voicemails from the Spam Contact</description>
    </key>

    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
      <description>Window maximized state</description>
    </key>

    <key name="window-size" type="(ii)">
      <default>(300, 600)</default>
      <summary>Window size</summary>
      <description>Window size (width, height).</description>
    </key>

    <key name="dark-theme" type="b">
      <default>false</default>
      <summary>Dark Theme</summary>
      <description>Dark Theme Enabled.</description>
    </key>

  </schema>
</schemalist>
