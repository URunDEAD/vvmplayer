  <id>org.kop316.vvmplayer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0+</project_license>
  <name>VVM Player</name>
  <summary>Visual Voicemail Player</summary>
  <developer_name>Chris Talbot</developer_name>
  <launchable type="desktop-id">org.kop316.vvmplayer.desktop</launchable>

  <description>
    <p>
      Visual Voicemail Player is a GUI app that plays and deletes Visual voicemails
      retreived by Visual Voicemail Daemon (vvmd).

    </p>
  </description>

  <screenshots>
