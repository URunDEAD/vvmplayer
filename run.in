#!/bin/bash
set -e

ABS_BUILDDIR='@ABS_BUILDDIR@'
ABS_SRCDIR='@ABS_SRCDIR@'

if [ "${PHOSH_ANTISPAM_GDB}" = 1 ]; then
    echo "Running vvmplayer under gdb"
    WRAPPER="gdb --directory=${ABS_BUILDDIR}/src --args"
fi

export GSETTINGS_SCHEMA_DIR="${ABS_BUILDDIR}/data"
set -x
export MALLOC_PERTURB_="$(($RANDOM % 255 + 1))"
MALLOC_CHECK_=2 exec ${WRAPPER} "${ABS_BUILDDIR}/src/vvmplayer" "$@"