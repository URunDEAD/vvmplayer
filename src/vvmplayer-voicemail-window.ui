<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.0"/>
  <requires lib="libhandy" version="0.0"/>
  <template class="VoicemailWindow" parent="HdyActionRow">
    <property name="visible">True</property>
    <property name="use-underline">True</property>
    <property name="activatable">True</property>
    <child>
      <object class="HdyExpanderRow" id="action_expander_row">
        <property name="visible">True</property>
        <child type="prefix">
          <object class="GtkButton">
          <property name="visible">True</property>
          <property name="valign">center</property>
          <signal name="clicked" handler="play_button_clicked_cb" swapped="no"/>
          <style>
            <class name="list-button"/>
          </style>
            <child>
              <object class="GtkImage" id="play_button_icon">
                <property name="visible">True</property>
                <property name="icon-name">media-playback-start</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="HdyActionRow" id="second_row">
          <property name="title" translatable="yes">00:00/??:??</property>
          <property name="visible">True</property>
          <child type="prefix">
            <object class="GtkButton">
            <property name="visible">True</property>
            <property name="valign">center</property>
            <signal name="clicked" handler="delete_button_clicked_cb" swapped="no"/>
            <style>
              <class name="list-button"/>
            </style>
              <child>
                <object class="GtkImage" id="delete_button_icon">
                  <property name="visible">True</property>
                  <property name="icon-name">edit-delete</property>
                </object>
              </child>
            </object>
          </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
